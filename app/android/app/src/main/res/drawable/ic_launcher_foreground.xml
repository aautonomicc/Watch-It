<?xml version="1.0" encoding="utf-8"?>
<!--
    Striped popcorn-bucket mark (branding/icon.svg) for the launcher
    icon foreground. Android 8+ launchers use THIS adaptive icon, not
    the mipmap PNGs — keep it in sync with the canonical SVG.

    Scale 0.17× from the SVG's 512 viewBox (content box 256×240
    centred at 256,280) into the 108×108 adaptive-icon viewport:

        x' = (x - 256) * 0.17 + 54    y' = (y - 280) * 0.17 + 54

    Farthest points are the top outer corners at ~29.8 from centre —
    inside the ~33 safe-circle radius launchers crop to.

    Bone #f5f2eb outer stripes, blue #42a5f5 centre stripe (icon-only
    accent, outside the BRAND.md token set). Background (ink #0a0a0a)
    supplied by the adaptive-icon XML.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#f5f2eb"
        android:pathData="M 32.24 33.6 L 40.944 33.6 L 46.656 74.4 L 41.76 74.4 Z" />

    <path
        android:fillColor="#42a5f5"
        android:pathData="M 49.648 33.6 L 58.352 33.6 L 56.448 74.4 L 51.552 74.4 Z" />

    <path
        android:fillColor="#f5f2eb"
        android:pathData="M 67.056 33.6 L 75.76 33.6 L 66.24 74.4 L 61.344 74.4 Z" />

</vector>
